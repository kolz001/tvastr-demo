# tvastr configuration — copy to .env and fill in for real integrations.
# With TVASTR_USE_MOCKS=true (the default) none of the secrets below are required;
# the app runs fully offline using in-memory mocks.

# --- Runtime ---
TVASTR_ENV=local
TVASTR_USE_MOCKS=true
# Dry-run: execute the full agent flow but skip the actual PR creation.
# Useful in live mode to inspect proposed changes before they touch GitHub.
TVASTR_DRY_RUN=false
TVASTR_LOG_LEVEL=INFO
TVASTR_LOG_JSON=false

# --- Hybrid LLM routing ---
# Local model (Ollama) — used for sensitive log parsing / clustering / PII redaction.
TVASTR_OLLAMA_BASE_URL=http://localhost:11434
TVASTR_OLLAMA_MODEL=llama3.1

# Cloud model (Claude) — used for root-cause reasoning, fix generation, PR descriptions.
ANTHROPIC_API_KEY=
TVASTR_CLAUDE_MODEL=claude-opus-4-7

# --- Storage (OpenSearch) ---
TVASTR_OPENSEARCH_URL=http://localhost:9200
TVASTR_OPENSEARCH_USER=admin
TVASTR_OPENSEARCH_PASSWORD=
TVASTR_OPENSEARCH_LOG_INDEX=tvastr-logs
TVASTR_OPENSEARCH_AUDIT_INDEX=tvastr-audit

# --- GitHub (target repo for remediation PRs) ---
GITHUB_TOKEN=
TVASTR_GITHUB_REPO=run-llama/llama_index
TVASTR_GITHUB_BASE_BRANCH=main

# --- Slack notifications ---
TVASTR_SLACK_WEBHOOK_URL=

# --- Detection thresholds ---
TVASTR_RECURRENCE_THRESHOLD=3
TVASTR_DEDUP_WINDOW_MINUTES=60
